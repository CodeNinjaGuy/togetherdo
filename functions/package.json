{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "node --test test/rules.test.mjs",
    "test:functions": "node --test --test-concurrency=1 test/functions.test.mjs",
    "test:termine": "node --test test/termine_logik.test.mjs test/monatsueberblick.test.mjs",
    "test:storage": "node --test --test-concurrency=1 test/storage.rules.test.mjs",
    "test:termine-regeln": "node --test --test-concurrency=1 test/termine.rules.test.mjs",
    "test:kalender-emulator": "node --test --test-concurrency=1 test/erinnerungen.test.mjs test/monatsueberblick_emulator.test.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-togetherdo 'npm run test:rules && npm run test:termine-regeln && npm run test:storage && npm run test:functions && npm run test:kalender-emulator'",
    "test": "npm run build && npm run test:termine && npm run test:emulator"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/nodemailer": "^6.4.17",
    "firebase": "^11.10.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.8.3"
  },
  "private": true
}
