{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "node --test test/rules.test.mjs",
    "test:functions": "node --test --test-concurrency=1 test/functions.test.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-togetherdo 'npm run test:rules && npm run test:functions'"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.8.3"
  },
  "private": true
}
