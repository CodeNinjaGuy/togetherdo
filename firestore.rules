// Written by Martin Bundschuh.
//
// Firestore-Regeln für ToGetherDo – Mitglieder-Prinzip.
//
// - Listen sieht nur, wer in `allUserIds` steht (Besitzer + Mitglieder).
// - Todos, Chats und Einkaufsartikel erben die Rechte ihrer Liste:
//   lesen = Mitglied, schreiben = Besitzer oder Mitglied mit `allowEdit`.
//   Abhaken im Einkauf und bei Todos dürfen alle Mitglieder.
// - Fair verteilt (Todos): `effort` nur leicht/mittel/schwer, zuständig nur
//   ein Mitglied der Liste, erledigt-von nur die eigene uid, Erledigt-Zeit
//   nur die Serverzeit der Anfrage.
// - Listen anlegen, per Code suchen und beitreten geht nur über die
//   Cloud Functions (createList, previewListByCode, joinListByCode) – so
//   lassen sich Codes nicht durchprobieren und keine Codes fälschen.
// - Kontolöschung läuft serverseitig (deleteAccount / onUserDeleted).
// - `produkte/{ean}` ist der gemeinsame Zwischenspeicher des Strichcode-
//   Scanners: Angemeldete lesen und legen an; Open-Facts-Daten (Quelle
//   off/obf/opf) werden nie überschrieben, Löschen ist verboten.
// - Anhänge (`todos/{id}/attachments`): anhängen darf jedes Mitglied,
//   löschen die hochladende Person oder wer die Liste bearbeiten darf.
// - `termine` (Familienkalender): lesen/anlegen = Mitglied, ändern/löschen =
//   Ersteller oder Besitzer/Mitglied mit allowEdit, Felder werden geprüft.
// - Alles, was hier nicht erlaubt ist (z. B. `shares`, `rateLimits`), ist verboten.
//
// Tests: functions/test/rules.test.mjs und functions/test/termine.rules.test.mjs
// (Firestore-Emulator).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function listDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }

    function isListMember(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lists/$(listId))
        && request.auth.uid in listDoc(listId).data.allUserIds;
    }

    function canEditList(listId) {
      let list = listDoc(listId).data;
      return isListMember(listId)
        && (list.ownerId == request.auth.uid
            || (request.auth.uid in list.memberIds && list.get('allowEdit', true) != false));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------------------------------------------------------------- users
    // Profil: nur die Person selbst schreibt. Einzelne Profile lesen dürfen
    // Angemeldete (Namen/Profilbilder von Mitgliedern); Auflisten ist verboten.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && unchanged('id');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------- lists
    match /lists/{listId} {
      // `resource == null`: Abfrage einer gelöschten Liste liefert „nicht
      // vorhanden“ statt eines Rechtefehlers (Live-Ansicht bei Mitgliedern).
      allow read: if signedIn()
        && (resource == null
            || request.auth.uid in resource.data.allUserIds
            || resource.data.ownerId == request.auth.uid);

      // Anlegen nur über die Function createList (eindeutiger Code).
      allow create: if false;

      // Besitzer: Name/Einstellungen ändern, Mitglieder entfernen – aber
      // niemanden hinzufügen und Besitz/Code/Typ nicht ändern.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && unchanged('ownerId')
        && unchanged('shareCode')
        && unchanged('id')
        && unchanged('type')
        && unchanged('createdAt')
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.toSet()
             .difference(resource.data.memberIds.toSet()).size() == 0
        && request.resource.data.allUserIds.toSet()
             == [request.auth.uid].toSet().union(request.resource.data.memberIds.toSet())
        && request.resource.data.memberNames.size() == request.resource.data.memberIds.size();

      // Mitglied: nur sich selbst austragen.
      allow update: if signedIn()
        && resource.data.ownerId != request.auth.uid
        && request.auth.uid in resource.data.memberIds
        && changedKeys().hasOnly(['memberIds', 'memberNames', 'allUserIds', 'updatedAt'])
        && request.resource.data.memberIds.toSet()
             == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
        && request.resource.data.allUserIds.toSet()
             == resource.data.allUserIds.toSet().difference([request.auth.uid].toSet())
        && request.resource.data.memberNames.size() == request.resource.data.memberIds.size();

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------- todos
    // Gültige Werte für „fair verteilt“. Fehlende Felder sind erlaubt
    // (alte Einträge; ohne Aufwand gilt „mittel“).
    function validEffort(d) {
      return d.get('effort', 'medium') in ['light', 'medium', 'heavy'];
    }

    function validAssignee(d, listId) {
      return d.get('assignedToUserId', null) == null
        || d.get('assignedToUserId', null) in listDoc(listId).data.allUserIds;
    }

    // Erledigt-von: nur man selbst (oder unverändert/geleert);
    // Erledigt-Zeit: nur die Serverzeit dieser Anfrage (oder unverändert/geleert),
    // und dann muss die Aufgabe von einem selbst erledigt sein.
    function validCompletion(d, isCreate) {
      let by = d.get('completedByUserId', null);
      let at = d.get('completedAt', null);
      return (by == null || by == request.auth.uid
                || (!isCreate && unchanged('completedByUserId')))
        && (at == null
              || (!isCreate && unchanged('completedAt'))
              || (at == request.time
                    && by == request.auth.uid
                    && d.get('isCompleted', false) == true));
    }

    match /todos/{todoId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || isListMember(resource.data.listId));

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == todoId
        && canEditList(request.resource.data.listId)
        && validEffort(request.resource.data)
        && validAssignee(request.resource.data, request.resource.data.listId)
        && validCompletion(request.resource.data, true);

      // Bearbeiten (Titel, Zuständigkeit, Aufwand …): Besitzer oder
      // Mitglied mit allowEdit.
      allow update: if signedIn()
        && canEditList(resource.data.listId)
        && unchanged('listId')
        && unchanged('userId')
        && unchanged('id')
        && validEffort(request.resource.data)
        && (unchanged('assignedToUserId')
            || validAssignee(request.resource.data, resource.data.listId))
        && validCompletion(request.resource.data, false);

      // Abhaken bzw. wieder öffnen: jedes Mitglied, nur die Erledigt-Felder.
      allow update: if signedIn()
        && isListMember(resource.data.listId)
        && changedKeys().hasOnly(['isCompleted', 'completedByUserId',
                                  'completedByUserName', 'completedAt'])
        && validCompletion(request.resource.data, false);

      allow delete: if signedIn() && canEditList(resource.data.listId);

      function todoListId() {
        return get(/databases/$(database)/documents/todos/$(todoId)).data.listId;
      }

      // Bild im Chat (Storage `chats/{listId}/{todoId}/…`): optional,
      // nur https-Adresse und Pfad in begrenzter Länge.
      function validChatImage(d) {
        return (d.get('imageUrl', null) == null
                || (d.imageUrl is string && d.imageUrl.size() <= 1000
                    && d.imageUrl.matches('^https?://.*')))
          && (d.get('imagePath', null) == null
              || (d.imagePath is string && d.imagePath.size() <= 500));
      }

      // Anhänge (Fotos/PDF) einer Aufgabe. Die Datei liegt in Storage,
      // hier nur die Beschreibung. Anhängen darf jedes Mitglied, löschen
      // nur, wer hochgeladen hat, oder wer die Liste bearbeiten darf.
      match /attachments/{attachmentId} {
        function validAttachment(d) {
          return d.keys().hasOnly(['id', 'todoId', 'listId', 'name', 'path', 'url',
                                   'contentType', 'size', 'uploadedBy',
                                   'uploadedByName', 'createdAt'])
            && d.id == attachmentId
            && d.todoId == todoId
            && d.listId == todoListId()
            && d.uploadedBy == request.auth.uid
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 200
            && d.path is string && d.path.size() <= 500
            && d.path.matches('^todos/' + d.listId + '/' + todoId + '/.*')
            && d.url is string && d.url.size() <= 1000
            && d.contentType.matches('^(image/(jpeg|png|webp|heic)|application/pdf)$')
            && d.size is int && d.size > 0 && d.size <= 20 * 1024 * 1024;
        }

        allow read: if signedIn() && isListMember(todoListId());
        allow create: if signedIn()
          && isListMember(todoListId())
          && validAttachment(request.resource.data);
        allow update: if false;
        allow delete: if signedIn()
          && isListMember(todoListId())
          && (resource.data.uploadedBy == request.auth.uid
              || canEditList(todoListId()));
      }

      // Chat pro Todo
      match /chatMessages/{messageId} {

        allow read: if signedIn() && isListMember(todoListId());

        allow create: if signedIn()
          && isListMember(todoListId())
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.todoId == todoId
          && request.resource.data.id == messageId
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 4000
          && validChatImage(request.resource.data);

        // Gelesen-Markierung durch Mitglieder; Text bleibt unverändert.
        allow update: if signedIn()
          && isListMember(todoListId())
          && changedKeys().hasOnly(['isRead']);

        allow delete: if signedIn()
          && (canEditList(todoListId())
              || resource.data.userId == request.auth.uid);
      }
    }

    // ------------------------------------------------------- shopping_items
    match /shopping_items/{itemId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || isListMember(resource.data.listId));

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == itemId
        && canEditList(request.resource.data.listId);

      // Bearbeiten wie bei Todos; Abhaken („gekauft“) darf jedes Mitglied.
      allow update: if signedIn()
        && unchanged('listId')
        && unchanged('userId')
        && unchanged('id')
        && (canEditList(resource.data.listId)
            || (isListMember(resource.data.listId)
                && changedKeys().hasOnly(['isPurchased', 'purchasedBy', 'purchasedAt'])));

      allow delete: if signedIn() && canEditList(resource.data.listId);
    }

    // ------------------------------------------------------------ produkte
    // Zwischenspeicher für gescannte Strichcodes (Open Food Facts bzw. von
    // Nutzern benannt). Dokument-ID = Strichcode (8 oder 12–14 Ziffern).
    match /produkte/{ean} {
      function validProduct(d) {
        return d.keys().hasOnly(['ean', 'name', 'marke', 'menge', 'bildUrl',
                                 'quelle', 'aktualisiertAm', 'erstelltVon'])
          && d.ean == ean
          && ean.matches('^[0-9]{8}$|^[0-9]{12,14}$')
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
          && (d.get('marke', null) == null
              || (d.marke is string && d.marke.size() <= 120))
          && (d.get('menge', null) == null
              || (d.menge is string && d.menge.size() <= 120))
          && (d.get('bildUrl', null) == null
              || (d.bildUrl is string && d.bildUrl.size() <= 500
                  && d.bildUrl.matches('^https://.*')))
          && d.quelle in ['off', 'obf', 'opf', 'nutzer']
          && d.aktualisiertAm is string && d.aktualisiertAm.size() <= 40
          // Von Nutzern benannte Produkte tragen den Urheber.
          && (d.quelle != 'nutzer' || d.get('erstelltVon', null) == request.auth.uid);
      }

      allow read: if signedIn();

      allow create: if signedIn() && validProduct(request.resource.data);

      // Nur Nutzer-Einträge dürfen ersetzt werden (z. B. durch echte
      // Open-Facts-Daten oder eine Korrektur); Open-Facts-Daten bleiben.
      allow update: if signedIn()
        && resource.data.quelle == 'nutzer'
        && validProduct(request.resource.data);

      allow delete: if false;
    }

    // ------------------------------------------------------------- termine
    // Familienkalender: flache Sammlung mit `listId` (wie todos). Lesen und
    // anlegen dürfen alle Mitglieder der Liste; ändern/löschen der Ersteller
    // oder Besitzer/Mitglied mit allowEdit. Anhänge darf jedes Mitglied
    // hinzufügen und eigene wieder entfernen. `letzteErinnerungSchluessel`
    // schreibt nur die Erinnerungs-Function.
    function validTerminArt(a) {
      return a in ['termin', 'arzt', 'arbeit', 'urlaub', 'schule', 'geburtstag', 'sonstiges'];
    }

    function validWiederholung(w) {
      return w == null
        || (w is map
            && w.keys().hasOnly(['typ', 'intervall', 'wochentage', 'bisDatum', 'anzahl', 'ausnahmen'])
            && w.typ in ['taeglich', 'woechentlich', 'monatlich', 'jaehrlich']
            && w.get('intervall', 1) is int && w.intervall >= 1 && w.intervall <= 365
            && w.get('wochentage', []) is list && w.wochentage.size() <= 7
            && (w.get('bisDatum', null) == null || w.bisDatum is timestamp)
            && (w.get('anzahl', null) == null
                || (w.anzahl is int && w.anzahl >= 1 && w.anzahl <= 1000))
            && w.get('ausnahmen', []) is list && w.ausnahmen.size() <= 500);
    }

    function validAnhang(a) {
      return a is map
        && a.keys().hasOnly(['id', 'name', 'typ', 'groesse', 'pfad', 'vorschauPfad',
                             'hochgeladenVon', 'hochgeladenAm'])
        && a.id is string && a.id.size() >= 1 && a.id.size() <= 80
        && a.name is string && a.name.size() >= 1 && a.name.size() <= 200
        && a.typ is string && a.typ.size() <= 100
        && a.groesse is int && a.groesse >= 0 && a.groesse <= 20 * 1024 * 1024
        && a.pfad is string && a.pfad.size() <= 400
        && a.hochgeladenVon is string;
    }

    function validAnhaenge(l) {
      // Einzelne Einträge prüft die App vollständig; hier Umfang und Form
      // der ersten Einträge (Regeln kennen keine Schleifen).
      return l is list && l.size() <= 20
        && (l.size() < 1 || validAnhang(l[0]))
        && (l.size() < 2 || validAnhang(l[l.size() - 1]));
    }

    function validTermin(d, terminId) {
      return d.keys().hasOnly(['id', 'listId', 'titel', 'art', 'personen', 'start', 'ende',
                               'ganztaegig', 'ort', 'notiz', 'zeitzone', 'wiederholung',
                               'erinnerungen', 'anhaenge', 'erstelltVon', 'erstelltAm',
                               'aktualisiertAm', 'sichtbarBis', 'naechsteErinnerungAm',
                               'letzteErinnerungSchluessel'])
        && d.id == terminId
        && d.listId is string
        && d.titel is string && d.titel.size() >= 1 && d.titel.size() <= 200
        && validTerminArt(d.art)
        && d.personen is list && d.personen.size() <= 50
        && listDoc(d.listId).data.allUserIds.hasAll(d.personen)
        && d.start is timestamp && d.ende is timestamp && d.ende > d.start
        && d.ganztaegig is bool
        && (d.get('ort', null) == null || (d.ort is string && d.ort.size() <= 200))
        && (d.get('notiz', null) == null || (d.notiz is string && d.notiz.size() <= 2000))
        && d.zeitzone is string && d.zeitzone.size() <= 64
        && validWiederholung(d.get('wiederholung', null))
        && d.erinnerungen is list && d.erinnerungen.size() <= 5
        && validAnhaenge(d.get('anhaenge', []))
        && d.erstelltVon is string
        && d.sichtbarBis is timestamp && d.sichtbarBis >= d.ende
        && (d.get('naechsteErinnerungAm', null) == null || d.naechsteErinnerungAm is timestamp);
    }

    function canEditTermin() {
      return resource.data.erstelltVon == request.auth.uid
        || canEditList(resource.data.listId);
    }

    match /termine/{terminId} {
      allow read: if signedIn() && isListMember(resource.data.listId);

      allow create: if signedIn()
        && isListMember(request.resource.data.listId)
        && request.resource.data.erstelltVon == request.auth.uid
        && request.resource.data.erstelltAm == request.time
        && request.resource.data.get('letzteErinnerungSchluessel', null) == null
        && validTermin(request.resource.data, terminId);

      // Bearbeiten: Ersteller oder Besitzer/Mitglied mit allowEdit.
      allow update: if signedIn()
        && unchanged('id') && unchanged('listId') && unchanged('erstelltVon')
        && unchanged('erstelltAm') && unchanged('letzteErinnerungSchluessel')
        && isListMember(resource.data.listId)
        && canEditTermin()
        && validTermin(request.resource.data, terminId);

      // Anhänge: jedes Mitglied darf eigene hinzufügen …
      allow update: if signedIn()
        && changedKeys().hasOnly(['anhaenge', 'aktualisiertAm'])
        && isListMember(resource.data.listId)
        && validAnhaenge(request.resource.data.anhaenge)
        && request.resource.data.anhaenge.hasAll(resource.data.anhaenge)
        && request.resource.data.anhaenge.size() == resource.data.anhaenge.size() + 1
        && request.resource.data.anhaenge[request.resource.data.anhaenge.size() - 1]
             .hochgeladenVon == request.auth.uid;

      // … und genau ein eigenes wieder entfernen.
      allow update: if signedIn()
        && changedKeys().hasOnly(['anhaenge', 'aktualisiertAm'])
        && isListMember(resource.data.listId)
        && resource.data.anhaenge.hasAll(request.resource.data.anhaenge)
        && resource.data.anhaenge.size() == request.resource.data.anhaenge.size() + 1
        && resource.data.anhaenge.removeAll(request.resource.data.anhaenge).size() == 1
        && resource.data.anhaenge.removeAll(request.resource.data.anhaenge)[0]
             .hochgeladenVon == request.auth.uid;

      allow delete: if signedIn()
        && isListMember(resource.data.listId)
        && canEditTermin();
    }

    // Alles andere (u. a. alte `shares`, `rateLimits`) ist für Clients gesperrt.
  }
}
